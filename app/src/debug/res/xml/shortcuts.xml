<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press Oavi's icon on the home screen for these. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_new_tab"
        android:shortcutId="new_tab"
        android:shortcutLongLabel="@string/shortcut_new_tab_long"
        android:shortcutShortLabel="@string/shortcut_new_tab">
        <intent
            android:action="com.oavi.browser.action.NEW_TAB"
            android:targetClass="com.oavi.browser.MainActivity"
            android:targetPackage="com.oavi.browser.debug" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_private_tab"
        android:shortcutId="private_tab"
        android:shortcutLongLabel="@string/shortcut_private_tab_long"
        android:shortcutShortLabel="@string/shortcut_private_tab">
        <intent
            android:action="com.oavi.browser.action.NEW_PRIVATE_TAB"
            android:targetClass="com.oavi.browser.MainActivity"
            android:targetPackage="com.oavi.browser.debug" />
    </shortcut>
</shortcuts>
